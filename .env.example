# Copy to apps/<app>/.env.local (or export in your shell) and fill in real values.
# All NEXT_PUBLIC_* values are embedded in the browser bundle at build time.

# --- Firebase Authentication (Firebase console → Project settings → Your apps → Web app) ---
# Web API key of the Firebase project
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
# Auth domain, usually <project-id>.firebaseapp.com (must be an authorised domain for Google popup sign-in)
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Firebase project id (the backend verifies ID tokens against this project)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
# Firebase web app id, e.g. 1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
# Optional: Cloud Messaging sender id (only needed if push messaging is enabled)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# --- Edition TV backend ---
# Public REST base URL (including /api/v1) used by the browser; /auth/me, /articles, ... hang off it
NEXT_PUBLIC_API_URL=https://api1.editiontv.com/api/v1
# Same as above; kept for apps that read NEXT_PUBLIC_API_BASE_URL (public-web)
NEXT_PUBLIC_API_BASE_URL=https://api1.editiontv.com/api/v1
# Server-only base URL for Server Component fetches (Docker/k8s internal routing); falls back to the public URL
INTERNAL_API_URL=http://edition-backend:8080/api/v1

# --- Sibling apps (used for cross-app links, e.g. admin -> CMS Studio) ---
# CMS Studio is served at partner.editiontv.com; cms.editiontv.com has no DNS record
NEXT_PUBLIC_CMS_STUDIO_URL=https://partner.editiontv.com
NEXT_PUBLIC_PUBLIC_WEB_URL=https://editiontv.com
