# Edition TV — Environment Configuration
# Default backend URL is https://api.editiontv.com if these are not set.

# Public API URL (client-side base URL, proxied locally by Next.js rewrites)
NEXT_PUBLIC_API_URL=https://api.editiontv.com/api/v1

# Internal API URL (server-to-server calls during SSR / ISR in Docker or Kubernetes)
INTERNAL_API_URL=https://api.editiontv.com/api/v1
