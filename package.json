{
  "name": "edition-platform-frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:public-web",
    "env:pull": "bash scripts/env-from-openbao.sh",
    "build": "npm run build:public-web",
    "dev:public-web": "npm run dev --prefix apps/public-web",
    "dev:partner": "npm run dev --prefix apps/partner-portal",
    "dev:admin": "npm run dev --prefix apps/admin",
    "build:public-web": "npm run build --prefix apps/public-web",
    "build:partner": "npm run build --prefix apps/partner-portal",
    "build:admin": "npm run build --prefix apps/admin",
    "build:admin:cf": "pnpm --filter @edition/admin build:cf",
    "deploy:admin:cf": "pnpm --filter @edition/admin deploy:cf",
    "build:public-web:cf": "pnpm --filter @edition/public-web build:cf",
    "deploy:public-web:cf": "pnpm --filter @edition/public-web deploy:cf",
    "build:partner:cf": "pnpm --filter @edition/partner-portal build:cf",
    "deploy:partner:cf": "pnpm --filter @edition/partner-portal deploy:cf",
    "lint:public-web": "npm run lint --prefix apps/public-web",
    "lint:partner": "npm run lint --prefix apps/partner-portal",
    "lint:admin": "npm run lint --prefix apps/admin",
    "lint": "npm run lint:public-web && npm run lint:partner && npm run lint:admin",
    "format": "npx -y prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "build:all": "npm run build:public-web && npm run build:partner && npm run build:admin",
    "lint:all": "npm run lint:public-web && npm run lint:partner && npm run lint:admin",
    "swagger:validate": "swagger-cli validate",
    "swagger:bundle": "swagger-cli bundle",
    "swagger:types": "openapi-typescript",
    "api:types": "openapi-typescript https://swagger.editiontv.com/v3/api-docs -o packages/api/schema.d.ts",
    "api:types:local": "openapi-typescript openapi.json -o packages/api/schema.d.ts"
  },
  "devDependencies": {
    "@apidevtools/swagger-cli": "^4.0.4",
    "openapi-typescript": "^7.13.0"
  }
}
