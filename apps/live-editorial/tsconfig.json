{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@edition/ui": ["../../packages/ui"],
      "@edition/api": ["../../packages/api"],
      "@edition/auth": ["../../packages/auth"],
      "@edition/config": ["../../packages/config"],
      "@edition/types": ["../../packages/types"],
      "@edition/utils": ["../../packages/utils"],
      "@edition/hooks": ["../../packages/hooks"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
