{
  "name": "edition-tv-admin",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://api1.editiontv.com/api/v1",
    "NEXT_PUBLIC_API_BASE_URL": "https://api1.editiontv.com/api/v1"
  }
}
