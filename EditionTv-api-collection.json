            "url": {
              "raw": "{{baseUrl}}/newsroom/wire-items/reader?page=0&size=50",
              "host": ["{{baseUrl}}"],
              "path": ["newsroom", "wire-items", "reader"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "50" }
              ]
            }
          }
        },
        {
          "name": "Get Wire Items Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/newsroom/wire-items/stats",
              "host": ["{{baseUrl}}"],
              "path": ["newsroom", "wire-items", "stats"]
