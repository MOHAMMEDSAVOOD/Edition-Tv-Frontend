          }
        },
        {
          "name": "Get All Users (Admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            }
          }
        },
        {
          "name": "Get RBAC Roles",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rbac/roles",
              "host": ["{{baseUrl}}"],
              "path": ["rbac", "roles"]
            }
          }
        }
      ]
    },
    {
      "name": "CMS Studio APIs",
      "item": [
        {
          "name": "Get Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cms/categories",
              "host": ["{{baseUrl}}"],
              "path": ["cms", "categories"]
            }
          }
        },
        {
          "name": "Create Category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"World News\",\n  \"slug\": \"world-news\",\n  \"description\": \"Global news and analysis\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/cms/categories",
              "host": ["{{baseUrl}}"],
              "path": ["cms", "categories"]
            }
          }
        },
        {
          "name": "Create Article Draft",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Major Global Event Unfolds\",\n  \"slug\": \"major-global-event-unfolds\",\n  \"summary\": \"Summary of global event\",\n  \"content\": \"<p>Full story content...</p>\",\n  \"categoryId\": \"cat-world-1\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/articles",
              "host": ["{{baseUrl}}"],
              "path": ["articles"]
            }
          }
        },
        {
          "name": "Submit Article for Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/articles/1/submit",
              "host": ["{{baseUrl}}"],
              "path": ["articles", "1", "submit"]
            }
          }
        },
        {
          "name": "Publish Article",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/articles/1/publish",
              "host": ["{{baseUrl}}"],
              "path": ["articles", "1", "publish"]
            }
          }
        },
        {
          "name": "Upload Media Asset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "caption", "value": "Hero image banner", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/media/upload",
              "host": ["{{baseUrl}}"],
              "path": ["media", "upload"]
            }
          }
        }
      ]
    },
